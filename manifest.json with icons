{
  "manifest_version": 3,
  "name": "AI Deal & Promo Finder",
  "version": "1.0.0",
  "description": "Search the internet for active AI promo codes, free API credits, and trial offers.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Find AI Promo Codes & Free Offers",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
